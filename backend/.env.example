# Server
PORT=5001
MONGO_URI=mongodb://localhost:27017/your_db_name
API_BASE_URL=http://localhost:5001
BASE_URL=http://localhost:5001
FRONTEND_URL=http://localhost:5173

# CORS (comma-separated)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# JWT (min 32 chars each)
JWT_ACCESS_SECRET=your-access-secret-min-32-characters-long
JWT_REFRESH_SECRET=your-refresh-secret-min-32-characters-long
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ImageKit.io
IMAGEKIT_PUBLIC_KEY=your_public_key
IMAGEKIT_PRIVATE_KEY=your_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# SSLCOMMERZ (Bangladesh)
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWD=your_store_password
SSLCOMMERZ_IS_LIVE=false

# Optional: NODE_ENV=production for secure cookies
NODE_ENV=development
